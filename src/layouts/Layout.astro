---
import '../styles/style.css';
import '../styles/dark-mode.css';
import { localeInfo, defaultLocale, localePath, type Locale, type Translation } from '../i18n';
import { sameAs } from '../data/social';

interface Props {
  locale: Locale;
  t: Translation;
}

const { locale, t } = Astro.props;
// Built from `site` + `base` in astro.config.mjs so the two never drift apart.
const BASE = new URL(import.meta.env.BASE_URL, Astro.site).href.replace(/\/$/, '');
const urlFor = (code: Locale) => `${BASE}/${localePath(code)}`;
const ogImage = BASE + '/assets/images/og-image.jpg';
const canonical = urlFor(locale);
const ogLocale = localeInfo.find((info) => info.code === locale)?.og ?? 'en_US';
const ogAlternates = localeInfo.filter((info) => info.code !== locale).map((info) => info.og);
const hreflangs = [
  ...localeInfo.map(({ code }) => ({ code, url: urlFor(code) })),
  { code: 'x-default', url: urlFor(defaultLocale) }
];
---
<!doctype html>
<html lang={locale}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- SEO Meta Tags -->
  <title>{t['seo.title']}</title>
  <meta name="description" content={t['seo.description']}>
  <meta name="author" content="Natan">
  <meta name="robots" content="index, follow">

  <!-- Open Graph / Social Media Meta Tags -->
  <meta property="og:type" content="website">
  <meta property="og:title" content={t['seo.ogTitle']}>
  <meta property="og:description" content={t['seo.ogDescription']}>
  <meta property="og:url" content={canonical}>
  <meta property="og:locale" content={ogLocale}>
  {ogAlternates.map((og) => <meta property="og:locale:alternate" content={og} />)}
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content={t['seo.ogTitle']}>

  <!-- Twitter Card Meta Tags -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:site" content="@natanohj_9">
  <meta name="twitter:creator" content="@natanohj_9">

  <!-- Favicon -->
  <link rel="icon" href={import.meta.env.BASE_URL + 'assets/images/favi.ico'} type="image/x-icon">

  <!-- Canonical URL -->
  <link rel="canonical" href={canonical}>

  <!-- Hreflang Alternates -->
  {hreflangs.map(({ code, url }) => (
    <link rel="alternate" hreflang={code} href={url} />
  ))}

  <!-- Preload Critical Resources -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>

  <!-- Stylesheets (CDNs) -->
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.css">

  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Person',
    'name': 'Natanohj',
    'url': BASE + '/',
    'sameAs': sameAs(),
    'image': ogImage,
    'jobTitle': 'Content Creator and Programmer',
    'description': 'Content creator and programmer sharing passion for technology, gaming, and creative content.',
    'knowsAbout': ['Programming', 'Content Creation', 'Gaming', 'Technology']
  })}></script>
</head>
<body>
  <script is:inline>
    // Apply the saved theme before first paint so dark mode does not flash white.
    try { if (localStorage.getItem('theme') === 'dark') document.body.classList.add('dark-mode'); } catch (e) {}
  </script>
  <a href="#main-content" class="skip-link">{t['a11y.skip']}</a>
  <slot />
  <script is:inline src="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.js"></script>
  <script src="../scripts/aos-init.js"></script>
  <script src="../scripts/nav.js"></script>
  <script src="../scripts/theme.js"></script>
  <script src="../scripts/oshi.js"></script>
</body>
</html>

---
import type { Translation } from '../i18n';

interface Props {
  t: Translation;
}

const { t } = Astro.props;
const year = new Date().getFullYear();
---
<footer class="footer" role="contentinfo">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <p class="footer-wordmark" translate="no">Natanohj<span>.</span></p>

        <nav aria-label={t['footer.quickLinks']}>
          <ul class="footer-menu">
            <li><a href="#hero">{t['nav.home']}</a></li>
            <li><a href="#content-creator">{t['nav.contentCreator']}</a></li>
            <li><a href="#programmer">{t['nav.programmer']}</a></li>
            <li><a href="#contact">{t['nav.contact']}</a></li>
            <li><a href="https://youtube.com/@natanyume" target="_blank" rel="noopener">YouTube</a></li>
            <li><a href="https://github.com/Natanmiuz" target="_blank" rel="noopener">GitHub</a></li>
          </ul>
        </nav>
      </div>

      <div class="footer-blocks">
        <div>
          <h2 class="footer-title">{t['footer.about']}</h2>
          <p>{t['footer.aboutText']}</p>
        </div>
        <div>
          <h2 class="footer-title">{t['footer.followMe']}</h2>
          <ul class="footer-social">
            <li><a href="https://www.tiktok.com/@natan.kimito" class="footer-social-link tiktok" target="_blank" rel="noopener">TikTok</a></li>
            <li><a href="https://youtube.com/@natanyume" class="footer-social-link youtube" target="_blank" rel="noopener">YouTube</a></li>
            <li><a href="https://www.facebook.com/profile.php?id=61593569911560" class="footer-social-link facebook" target="_blank" rel="noopener">Facebook</a></li>
            <li><a href="https://x.com/natanohj_9" class="footer-social-link twitter" target="_blank" rel="noopener">Twitter/X</a></li>
            <li><a href="https://www.instagram.com/natansolano_" class="footer-social-link instagram" target="_blank" rel="noopener">Instagram</a></li>
            <li><a class="footer-social-link twitch disabled" aria-disabled="true">Twitch</a></li>
            <li><a class="footer-social-link kick disabled" aria-disabled="true">Kick</a></li>
          </ul>
        </div>
      </div>
    </div>

    <p class="footer-bottom">&copy; {year} {t['footer.copyright']}</p>
  </div>
</footer>

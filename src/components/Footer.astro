---
import type { Translation } from '../i18n';
import { social, youtube, github } from '../data/social';

interface Props {
  t: Translation;
}

const { t } = Astro.props;
const year = new Date().getFullYear();
---
<footer class="footer" role="contentinfo">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <p class="footer-wordmark" translate="no">Natanohj<span>.</span></p>

        <nav aria-label={t['footer.quickLinks']}>
          <ul class="footer-menu">
            <li><a href="#hero">{t['nav.home']}</a></li>
            <li><a href="#content-creator">{t['nav.contentCreator']}</a></li>
            <li><a href="#programmer">{t['nav.programmer']}</a></li>
            <li><a href="#contact">{t['nav.contact']}</a></li>
            <li><a href={youtube.url} target="_blank" rel="noopener">{youtube.name}</a></li>
            <li><a href={github} target="_blank" rel="noopener">GitHub</a></li>
          </ul>
        </nav>
      </div>

      <div class="footer-blocks">
        <div>
          <h2 class="footer-title">{t['footer.about']}</h2>
          <p>{t['footer.aboutText']}</p>
        </div>
        <div>
          <h2 class="footer-title">{t['footer.followMe']}</h2>
          <ul class="footer-social">
            {social.map((link) => (
              <li>
                {link.url
                  ? <a href={link.url} class={`footer-social-link ${link.id}`} target="_blank" rel="noopener">{link.name}</a>
                  : <a class={`footer-social-link ${link.id} disabled`} aria-disabled="true">{link.name}</a>}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <p class="footer-bottom">&copy; {year} {t['footer.copyright']}</p>
  </div>
</footer>

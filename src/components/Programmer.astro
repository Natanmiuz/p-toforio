---
import type { Translation } from '../i18n';

interface Props {
  t: Translation;
}

const { t } = Astro.props;
---
<section class="section" id="programmer">
  <div class="container">
    <div class="section-title" data-aos="fade-up">
      <h2>{t['programmer.title']}</h2>
      <p>{t['programmer.subtitle']}</p>
    </div>

    <div class="simple-content" data-aos="fade-up">
      <p class="programmer-description">{t['programmer.description']}</p>

      <div class="simple-projects" data-aos="fade-up">
        <h3>{t['programmer.projects.title']}</h3>
        <ul class="projects-list">
          <li>
            <a href="https://olaolapasapasa.vercel.app/" class="project-title" target="_blank" rel="noopener">
              olaolapasapasa <i class="fa-solid fa-arrow-up-right-from-square"></i>
            </a>
            - <span>{t['programmer.projects.olaolapasapasa']}</span>
          </li>
          <li>
            <a href="https://github.com/Natanmiuz/mp3-mp4-downloader/releases/tag/v.20" class="project-title" target="_blank" rel="noopener">
              Notnet <i class="fa-solid fa-arrow-up-right-from-square"></i>
            </a>
            - <span>{t['programmer.projects.notnet']}</span>
          </li>
          <li>
            <a href="https://github.com/Natanmiuz/VideoConvert" class="project-title" target="_blank" rel="noopener">
              VideoConvert <i class="fa-solid fa-arrow-up-right-from-square"></i>
            </a>
            - <span>{t['programmer.projects.videoConvert']}</span>
          </li>
        </ul>
      </div>

      <div class="github-section" data-aos="fade-up">
        <p>{t['programmer.github.message']}</p>
        <a href="https://github.com/Natanmiuz" class="github-link" target="_blank" rel="noopener">
          <i class="fab fa-github"></i>
          <span>{t['programmer.github.profile']}</span>
        </a>
      </div>
    </div>
  </div>
</section>

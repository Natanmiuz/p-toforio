---
import type { Translation } from '../i18n';
import { projects } from '../data/projects';
import { github } from '../data/social';

interface Props {
  t: Translation;
}

const { t } = Astro.props;
---
<section class="section" id="programmer">
  <div class="container">
    <div class="section-title" data-aos="fade-up">
      <h2>{t['programmer.title']}</h2>
      <p>{t['programmer.subtitle']}</p>
    </div>

    <div class="simple-content" data-aos="fade-up">
      <p class="programmer-description">{t['programmer.description']}</p>

      <div class="simple-projects" data-aos="fade-up">
        <h3>{t['programmer.projects.title']}</h3>
        <ul class="projects-list">
          {projects.map((project) => (
            <li>
              <a href={project.url} class="project-title" target="_blank" rel="noopener">
                {project.name} <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
              </a>
              - <span>{t[project.descKey]}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="github-section" data-aos="fade-up">
        <p>{t['programmer.github.message']}</p>
        <a href={github} class="github-link" target="_blank" rel="noopener">
          <i class="fab fa-github"></i>
          <span>{t['programmer.github.profile']}</span>
        </a>
      </div>
    </div>
  </div>
</section>

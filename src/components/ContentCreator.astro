---
import type { Translation } from '../i18n';
import { getLatestVideo } from '../lib/youtube';
import { social, youtube } from '../data/social';

interface Props {
  t: Translation;
}

const { t } = Astro.props;
const video = await getLatestVideo();
const watchUrl = `https://www.youtube.com/watch?v=${video.id}`;
const embedUrl = `https://www.youtube.com/embed/${video.id}`;
---
<section class="section" id="content-creator">
  <div class="container">
    <div class="section-title" data-aos="fade-up">
      <h2>{t['content.title']}</h2>
      <p>{t['content.subtitle']}</p>
    </div>

    <div class="latest-content" data-aos="fade-up">
      <h3 class="content-title">{video.title}</h3>
      <div class="video-container">
        <a
          class="plate"
          href={watchUrl}
          target="_blank"
          rel="noopener"
          data-embed={embedUrl}
          aria-label={`${t['content.play']}: ${video.title}`}
        >
          <img src={video.thumbnail} alt="" width="1280" height="720" loading="lazy" decoding="async" />
          <svg class="record" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
            <circle cx="50" cy="50" r="43" fill="none" stroke="currentColor" stroke-width="1.2" opacity=".9" />
          </svg>
          <span class="play" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M6 4l15 8-15 8z" /></svg>
          </span>
        </a>
      </div>
      <div class="video-actions">
        <a class="btn btn-primary" href={watchUrl} target="_blank" rel="noopener" data-play>
          <i class="fas fa-play" aria-hidden="true"></i> {t['content.play']}
        </a>
        <a class="btn btn-secondary" href={`${youtube.url}/videos`} target="_blank" rel="noopener">
          {t['content.latestVideos']} <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
        </a>
      </div>
    </div>

    <div class="social-links" data-aos="fade-up">
      {social.map((link) => link.url ? (
        <a href={link.url} class={`social-link ${link.id}`} target="_blank" rel="noopener">
          <i class={link.icon} aria-hidden="true"></i>
          <span>{link.name}</span>
        </a>
      ) : (
        <a class={`social-link ${link.id} disabled`} aria-disabled="true">
          <i class={link.icon} aria-hidden="true"></i>
          <span>{link.name}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<script>
  // The video loads only when asked for; without script the cover links to it.
  const plate = document.querySelector<HTMLAnchorElement>('.plate[data-embed]');
  const play = () => {
    if (!plate || plate.dataset.playing) return;
    plate.dataset.playing = 'true';
    const iframe = document.createElement('iframe');
    iframe.src = plate.dataset.embed + '?autoplay=1';
    iframe.title = 'YouTube video player';
    iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
    iframe.allowFullscreen = true;
    plate.replaceWith(iframe);
    iframe.focus();
  };
  plate?.addEventListener('click', (e) => { e.preventDefault(); play(); });
  document.querySelector('[data-play]')?.addEventListener('click', (e) => {
    if (!plate?.isConnected) return;
    e.preventDefault();
    plate.closest('.video-container')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
    play();
  });
</script>

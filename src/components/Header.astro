---
import { localeInfo, localePath, type Locale, type Translation } from '../i18n';

interface Props {
  t: Translation;
  locale: Locale;
}

const { t, locale } = Astro.props;
---
<header>
  <nav class="navbar" aria-label={t['a11y.mainNav']}>
    <div class="container">
      <div class="nav-left">
        <a href="#hero" class="logo" aria-label={t['a11y.homeLink']}>Natanohj<span>.</span></a>
      </div>

      <div class="nav-center">
        <ul class="nav-menu" id="nav-menu">
          <li class="nav-item"><a href="#hero" class="nav-link active">{t['nav.home']}</a></li>
          <li class="nav-item"><a href="#content-creator" class="nav-link">{t['nav.contentCreator']}</a></li>
          <li class="nav-item"><a href="#programmer" class="nav-link">{t['nav.programmer']}</a></li>
          <li class="nav-item"><a href="#contact" class="nav-link">{t['nav.contact']}</a></li>
        </ul>
      </div>

      <div class="nav-right">
        <div class="nav-controls">
          <select id="language-switcher" aria-label={t['a11y.language']}>
            {localeInfo.map(({ code, name }) => (
              <option value={code} lang={code} selected={code === locale} data-href={import.meta.env.BASE_URL + localePath(code)}>{name}</option>
            ))}
          </select>
          <button type="button" id="theme-toggle" aria-label={t['a11y.toggleTheme']}>
            <i class="fas fa-moon" aria-hidden="true"></i>
          </button>
        </div>
        <button type="button" class="hamburger" id="hamburger" aria-label={t['a11y.menu']} aria-controls="nav-menu" aria-expanded="false">
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
        </button>
      </div>
    </div>
  </nav>
</header>

<script>
  const switcher = document.getElementById('language-switcher') as HTMLSelectElement | null;
  switcher?.addEventListener('change', () => {
    const href = switcher.selectedOptions[0]?.dataset.href;
    if (href) location.href = href;
  });
</script>

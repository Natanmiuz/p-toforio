---
import type { Translation } from '../i18n';

interface Props {
  t: Translation;
}

const { t } = Astro.props;
---
<section class="section" id="contact">
  <div class="container">
    <div class="section-title" data-aos="fade-up">
      <h2>{t['contact.title']}</h2>
      <p>{t['contact.subtitle']}</p>
    </div>

    <div class="contact-container">
      <div class="contact-info" data-aos="fade-up">
        <h3>{t['contact.connect']}</h3>
        <p>{t['contact.message']}</p>

        <div class="contact-method">
          <div class="contact-icon">
            <i class="fas fa-envelope"></i>
          </div>
          <a href="mailto:contact@natandev.com" class="contact-detail">{t['contact.email']}</a>
        </div>

        <div class="contact-method">
          <div class="contact-icon">
            <i class="fas fa-map-marker-alt"></i>
          </div>
          <span class="contact-detail">{t['contact.location']}</span>
        </div>

        <div class="contact-method">
          <div class="contact-icon">
            <i class="fas fa-comments"></i>
          </div>
          <span class="contact-detail">{t['contact.availability']}</span>
        </div>
      </div>

      <div class="contact-form" data-aos="fade-up" data-aos-delay="200">
        <form id="contactForm">
          <div class="form-group">
            <label for="name" class="form-label">{t['form.name']}</label>
            <input type="text" id="name" class="form-control" placeholder={t['form.placeholders.name']} required>
          </div>

          <div class="form-group">
            <label for="email" class="form-label">{t['form.email']}</label>
            <input type="email" id="email" class="form-control" placeholder={t['form.placeholders.email']} required>
          </div>

          <div class="form-group">
            <label for="message" class="form-label">{t['form.message']}</label>
            <textarea id="message" class="form-control" placeholder={t['form.placeholders.message']} required></textarea>
          </div>

          <button type="button" id="submitForm" class="btn btn-primary">{t['form.submit']}</button>
        </form>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ comingSoon: t['form.comingSoon'] }}>
  document.getElementById('submitForm')?.addEventListener('click', (e) => {
    e.preventDefault();
    alert(comingSoon);
  });
</script>

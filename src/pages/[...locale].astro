---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ContentCreator from '../components/ContentCreator.astro';
import Programmer from '../components/Programmer.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import { translations, locales, defaultLocale, type Locale } from '../i18n';

// One page for every locale: the default one is served at `/` (no prefix),
// the rest at `/<locale>/`.
export function getStaticPaths() {
  return locales.map((locale) => ({
    params: { locale: locale === defaultLocale ? undefined : locale },
    props: { locale },
  }));
}

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = translations[locale];
---
<Layout locale={locale} t={t}>
  <Header t={t} locale={locale} />
  <main id="main-content">
    <Hero t={t} />
    <ContentCreator t={t} />
    <Programmer t={t} />
    <Contact t={t} />
  </main>
  <Footer t={t} />
</Layout>
